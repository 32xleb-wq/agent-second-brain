[Unit]
Description=d-brain Telegram bot (drives the persistent Claude session)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=dbrain-notify@%n.service

[Service]
Type=simple
# KillMode=process: stopping/restarting the bot must NOT kill the detached
# tmux brain that lives in this unit's cgroup (the default control-group would
# take it down). The brain outlives bot restarts; ensure_session re-attaches.
KillMode=process
# A clean stop/restart exits 143 (SIGTERM); that is success, not a failure, so
# it must not trigger the OnFailure= alert.
SuccessExitStatus=143 SIGTERM
WorkingDirectory=%h/projects/dbrain
# Invoke the venv's python directly rather than `uv run ...`: uv forks the
# real interpreter as a CHILD process instead of exec'ing into it, so with
# KillMode=process (required above) systemd only signals the uv wrapper on
# stop/restart — the actual python process is left orphaned, still holding
# pane.lock and still polling Telegram, fighting the freshly started
# instance. Running the venv interpreter directly makes it the tracked main
# PID with no wrapper layer to leak.
ExecStart=%h/projects/dbrain/.venv/bin/python -m d_brain
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=CLAUDE_CONFIG_DIR=%h/.claude
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
